# ============================================================
#   Lexara — Environment Variables
#   Copy this file to .env and fill in your values.
#
#   NEVER commit .env to version control. It is listed in
#   .gitignore by default. The .env.example file (this file)
#   is safe to commit — it contains no real secrets.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Groq API key — obtain a free key at https://console.groq.com
# Used server-side only (server.js / api/chat.js).
# Never bundled into client-side JavaScript.
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Optional ─────────────────────────────────────────────────
# Groq model to use as the primary in the fallback ladder.
# If unset, the server defaults to llama-3.3-70b-versatile.
# Fallback ladder (automatic): llama-3.3-70b-versatile →
#   llama-3.1-8b-instant → mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Port for the local development server (default: 3000)
PORT=3000
